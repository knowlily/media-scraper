{
  "name": "@media-scraper/downloader",
  "version": "0.1.0",
  "description": "Resumable download manager with concurrency control for media-scraper",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo ok",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.5",
    "vitest": "^2"
  }
}
