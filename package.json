{
  "name": "media-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "输入网址，自动提取页面中所有媒体资源（图片、视频、音频、文档），支持预览与批量下载。",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0"
}
